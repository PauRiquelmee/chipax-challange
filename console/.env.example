# console/.env.example: solo variables públicas (todo VITE_* termina en el bundle del navegador).
# Nunca poner secretos aquí. Copiar a console/.env (no versionado).

VITE_APP_NAME=Chipax Challenge
VITE_API_BASE_URL=/api             # mismo origen: proxy de Vite en local, CloudFront en prod
VITE_API_PROXY_TARGET=http://localhost:3000   # solo dev server: destino del proxy /api
