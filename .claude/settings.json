{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_PROFILE": "chipax-challenge",
    "AWS_REGION": "us-east-1",
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_PAGER": "",
    "CDK_DISABLE_VERSION_CHECK": "true"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Artifact",
      "ArtifactComments",
      "mcp__claude-in-chrome",
      "mcp__langsmith",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(nvm:*)",
      "Bash(tsx:*)",
      "Bash(vitest:*)",
      "Bash(eslint:*)",
      "Bash(tsc:*)",
      "Bash(cdk:*)",
      "Bash(drizzle-kit:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(psql:*)",
      "Bash(pg_isready:*)",
      "Bash(aws:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(openssl rand:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(ln:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(zip:*)",
      "Bash(date:*)",
      "Bash(env:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(ss:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(xdg-open:*)",
      "Bash(open:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit --visibility:*)",
      "Bash(aws rds delete-db-instance:*)",
      "Bash(aws rds delete-db-cluster:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws cloudformation delete-stack:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(aws iam delete-:*)",
      "Bash(aws organizations:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(cdk destroy:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx) d=\"$CLAUDE_PROJECT_DIR/core\"; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/console/*) d=\"$CLAUDE_PROJECT_DIR/console\";; \"$CLAUDE_PROJECT_DIR\"/core/infra/*) d=\"$CLAUDE_PROJECT_DIR/core/infra\";; esac; [ -d \"$d/node_modules\" ] && cd \"$d\" && npx eslint --fix \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ]
  }
}
