# core/infra/.env.example: variables para que el agente despliegue desde local (CDK + scripts).
# Copiar a core/infra/.env (no versionado, permisos 600) y llenar lo marcado con <- LLENAR.

APP_NAME=chipax-challenge
SSM_PREFIX=/chipax-challenge/prod

# =====================================================================
# AWS (la AWS CLI de Paula; el mismo perfil que fija .claude/settings.json)
# =====================================================================
AWS_PROFILE=chipax-challenge
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=                    # <- LLENAR. El agente lo compara con `aws sts get-caller-identity` antes de operar

# =====================================================================
# CLOUDFLARE: con esto el agente crea los DNS de challenge.woku.uk solo
# =====================================================================
# Token de API de Cloudflare (Mi perfil > API Tokens > Create Token > "Edit zone DNS"):
#   Permisos:  Zone > DNS > Edit   y   Zone > Zone > Read
#   Recursos:  Include > Specific zone > woku.uk
#   (opcional) Client IP filtering y fecha de expiración al terminar el proceso
# Lo crea quien administra la zona woku.uk en Cloudflare. Ver core/docs/infra.md, "Cloudflare".
CLOUDFLARE_API_TOKEN=              # <- LLENAR
CLOUDFLARE_ZONE_NAME=woku.uk
CLOUDFLARE_ZONE_ID=                # opcional: si está vacío, scripts/dns.ts lo busca con el token y lo escribe aquí
# Alternativa solo si no se puede crear un token (Global API Key, acceso total a la cuenta: evitar):
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# =====================================================================
# Dominio
# =====================================================================
DOMAIN=challenge.woku.uk
CERT_ARN=                          # lo escribe scripts/cert.ts (también queda en SSM)
CLOUDFRONT_DOMAIN=                 # lo escribe scripts/dns.ts tras el deploy (dxxxx.cloudfront.net)

# =====================================================================
# Costo
# =====================================================================
BUDGET_MONTHLY_USD=30              # alerta de AWS Budgets al 50/80/100 %
ALERT_EMAIL=                       # <- LLENAR. Correo de Paula para las alertas

# =====================================================================
# RDS
# =====================================================================
DB_INSTANCE_CLASS=db.t4g.micro
DB_ENGINE_VERSION=18
DB_NAME=challenge

# =====================================================================
# GitHub (deploy continuo con OIDC)
# =====================================================================
GITHUB_OWNER=                      # <- LLENAR. Usuario u organización de Paula
GITHUB_REPO=                       # <- LLENAR. Nombre del repo
