# core/.env.example: referencia versionada. Copiar a core/.env (no versionado) y llenar.
# Toda variable nueva se agrega aquí, en src/config/env.ts (zod) y en SSM de prod.

# --- App ---
APP_ENV=local                      # local | test | prod
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug                    # debug | info | warn | error
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173  # en prod no hace falta: front y API comparten origen

# --- Seguridad ---
ORIGIN_VERIFY_SECRET=              # vacío en local = no se exige X-Origin-Verify; en prod viene de SSM
AUTH_JWT_SECRET=                   # solo si el desafío tiene login (openssl rand -hex 32)

# --- PostgreSQL (docker compose en local, RDS en prod) ---
DATABASE_URL=postgres://challenge:challenge@localhost:5432/challenge
DATABASE_URL_TEST=postgres://challenge:challenge@localhost:5432/challenge_test
DATABASE_SSL=false                 # true en prod (RDS fuerza TLS)
DATABASE_POOL_MAX=5                # en Lambda se usa 2

# --- Archivos (MinIO en local, S3 en prod) ---
AWS_REGION=us-east-1
S3_BUCKET_UPLOADS=chipax-challenge-uploads-local
S3_ENDPOINT=http://localhost:9000  # vacío en prod
S3_FORCE_PATH_STYLE=true           # false en prod
S3_UPLOAD_MAX_MB=20
S3_PRESIGN_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=minioadmin       # solo MinIO local; en prod la Lambda usa su rol
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Claude (Claude Platform) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5          # modelo principal de los agentes
LLM_MODEL_FAST=claude-haiku-5-5    # clasificación, extracción y tareas simples
LLM_EFFORT=medium                  # low | medium | high | xhigh | max
LLM_MAX_TOKENS_PER_CONVERSATION=2000000

# --- LangSmith (trazas + Hub de prompts) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=chipax-challenge-local      # -local | -prod | -evals
LANGSMITH_USE_HUB=false                       # true en prod: prompts desde el Hub con respaldo local
LANGSMITH_PROMPT_PREFIX=chipax-challenge      # nombres en el Hub: chipax-challenge-<agente>
LANGCHAIN_CALLBACKS_BACKGROUND=false          # obligatorio en Lambda: no perder trazas al congelarse

# --- Solo en prod (lo pone CDK en la Lambda) ---
SSM_PREFIX=                        # /chipax-challenge/prod: la Lambda carga de aquí los secretos
AGENT_RUNS_FUNCTION_NAME=          # Lambda a invocar en modo asíncrono para corridas largas
